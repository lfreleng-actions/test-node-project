{
  "name": "test-node-project",
  "version": "1.0.0",
  "description": "Sample Node.js Project",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "node --test \"*.test.js\"",
    "test:ci": "mkdir -p reports && c8 node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml \"*.test.js\"",
    "build": "echo 'Hello build!'",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "author": "Matthew Watkins",
  "license": "Apache-2.0",
  "c8": {
    "all": true,
    "include": [
      "**/*.js"
    ],
    "exclude": [
      "**/*.test.js",
      "**/node_modules/**",
      "coverage/**",
      "reports/**",
      "variants/**",
      "**/*.config.{js,cjs,mjs}"
    ],
    "reporter": [
      "text",
      "lcov",
      "json-summary"
    ],
    "report-dir": "coverage"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
